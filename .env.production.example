# On Vercel, use the Supabase Transaction Pooler/Supavisor URL, not the direct IPv6-only DB host.
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?schema=neurorecrut&sslmode=require&pgbouncer=true&connection_limit=10&pool_timeout=20
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?schema=neurorecrut&sslmode=require&pgbouncer=true&connection_limit=10&pool_timeout=20"
NEXTAUTH_SECRET="generate-a-long-random-secret"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="generate-a-stable-32-byte-base64-key"
NEXTAUTH_URL="https://app.neurorecrut.com"
NEXT_PUBLIC_APP_URL="https://app.neurorecrut.com"
OPENAI_API_KEY="sk-..."
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-login"
SMTP_PASSWORD="your-smtp-key"
SMTP_SECURE="false"
EMAIL_FROM="NeuroRecrut <no-reply@neurorecrut.com>"

# Optional: create or update the first platform admin during production seed.
NEURORECRUT_ADMIN_EMAIL="admin@neurorecrut.com"
NEURORECRUT_ADMIN_PASSWORD="replace-with-a-strong-password"
